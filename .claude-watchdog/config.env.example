# Claude Code Auto-Resume Watchdog — configuration
# Copy to config.env and edit. config.env is gitignored (may hold webhook URLs).
# All values are optional; defaults (shown) are applied when unset.

# Path to the claude CLI (override if not on PATH).
CLAUDE_BIN=claude

# How often the daemon checks sessions, in seconds.
POLL_INTERVAL=30

# Extra seconds to wait after a detected reset time before resuming.
SAFETY_BUFFER_SECONDS=60

# Exponential backoff when no reset time is parseable: base doubles each retry,
# capped at max. Defaults: 10 min -> 20 -> 40 -> 60 (cap).
BACKOFF_BASE_SECONDS=600
BACKOFF_MAX_SECONDS=3600

# Stop auto-resuming a session after this many resumes (loop guard).
DEFAULT_MAX_RESUMES=5

# Model / cost controls (leave empty to use Claude Code defaults).
MODEL=
FALLBACK_MODEL=
MAX_BUDGET_USD=

# Permission mode for unattended runs. acceptEdits = auto-accept file edits;
# every other tool must be explicitly allow-listed below (default-deny).
PERMISSION_MODE=acceptEdits

# Tool policy (COMMA-separated; commas keep "Bash(git status:*)" intact).
# disallowed always wins over allowed. Tune these to your project.
ALLOWED_TOOLS=Read,Edit,Write,Grep,Glob,LS,TodoWrite,Task,NotebookEdit,WebFetch,WebSearch,Bash(git status:*),Bash(git diff:*),Bash(git log:*),Bash(git add:*),Bash(git commit:*),Bash(git checkout -b:*),Bash(git switch:*),Bash(git branch:*),Bash(npm test:*),Bash(npm run:*),Bash(npm ci:*),Bash(npm install:*),Bash(node:*),Bash(npx:*),Bash(ls:*),Bash(cat:*),Bash(pytest:*),Bash(python:*)
DISALLOWED_TOOLS=Bash(rm:*),Bash(git push --force:*),Bash(git push -f:*),Bash(git reset --hard:*),Bash(git clean:*),Bash(sudo:*),Bash(dd:*),Bash(mkfs:*),Bash(npm publish:*),Bash(* deploy*),Bash(* migrate*),Bash(* drop *),Bash(rmdir:*)

# Desktop notifications: 1 = on (osascript/notify-send/Windows toast), 0 = off.
NOTIFY_DESKTOP=1

# Optional notification webhooks. DO NOT hardcode secrets in committed files —
# set these here (config.env is gitignored) or export them in your shell.
# SLACK_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Prompt used when resuming a blocked session (the original task is in history).
# RESUME_PROMPT=Continue the task exactly where you left off. ...

# Safety instructions appended to every run's system prompt. Keep the
# NEEDS_USER_APPROVAL convention — the watchdog watches for it to pause.
# SAFETY_SYSTEM_PROMPT=You are running UNATTENDED ...
